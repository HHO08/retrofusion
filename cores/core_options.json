{
 "_comment": [
  "Per-core option schema. Values come straight from the work order (section 5)",
  "plus libretro community-proven defaults for weak devices.",
  "  default = balanced profile (mid-range phone)",
  "  potato  = weak-device profile; this is what a fresh install uses",
  " 'restart' marks options the core only reads at load time.",
  "Unknown/renamed keys are inert: CoreHost only returns a variable if the core",
  "asks for that exact key, so a stale key can never crash anything."
 ],

 "mupen64plus_next": [
  {"key": "mupen64plus-cpucore", "label": "CPU core", "kind": "enum",
   "choices": [["Interpreter", "pure_interpreter"], ["Cached interpreter", "cached_interpreter"], ["Dynamic recompiler", "dynamic_recompiler"]],
   "default": "dynamic_recompiler", "potato": "dynamic_recompiler", "restart": true,
   "info": "Dynarec is mandatory on weak devices; the interpreter cannot reach playable speed."},
  {"key": "mupen64plus-rspmode", "label": "RSP plugin", "kind": "enum",
   "choices": [["HLE (fast)", "hle"], ["LLE (accurate)", "lle"]],
   "default": "hle", "potato": "hle", "restart": true,
   "info": "HLE is far faster; LLE is only needed for a handful of games."},
  {"key": "mupen64plus-EnableFBEmulation", "label": "Frame buffer emulation", "kind": "enum",
   "choices": [["Enabled", "True"], ["Disabled", "False"]],
   "default": "True", "potato": "True",
   "info": "Keep enabled: disabling it breaks many games' menus and effects."},
  {"key": "mupen64plus-txHiresEnable", "label": "Hi-res textures", "kind": "enum",
   "choices": [["Enabled", "True"], ["Disabled", "False"]],
   "default": "False", "potato": "False",
   "info": "Always off on weak devices: custom textures cost RAM and bandwidth."},
  {"key": "mupen64plus-txFilterIgnoreBG", "label": "Ignore background textures", "kind": "enum",
   "choices": [["Enabled", "True"], ["Disabled", "False"]],
   "default": "True", "potato": "True"},
  {"key": "mupen64plus-MultiSampling", "label": "Anti-aliasing (MSAA)", "kind": "enum",
   "choices": [["Off", "0"], ["2x", "2"], ["4x", "4"], ["8x", "8"]],
   "default": "0", "potato": "0", "restart": true},
  {"key": "mupen64plus-EnableLegacyBlending", "label": "Legacy blending", "kind": "enum",
   "choices": [["Enabled", "True"], ["Disabled", "False"]],
   "default": "False", "potato": "False"},
  {"key": "mupen64plus-CountPerOp", "label": "Count per op", "kind": "int",
   "min": 0, "max": 6, "default": "1", "potato": "2",
   "info": "2 improves compatibility at some CPU cost; required by many titles."},
  {"key": "mupen64plus-ThreadedRenderer", "label": "Threaded renderer", "kind": "enum",
   "choices": [["Enabled", "True"], ["Disabled", "False"]],
   "default": "True", "potato": "True"}
 ],

 "flycast": [
  {"key": "reicast_internal_resolution", "label": "Internal resolution", "kind": "enum",
   "choices": [["640x480 (native)", "640x480"], ["1280x960", "1280x960"], ["1920x1440", "1920x1440"]],
   "default": "640x480", "potato": "640x480",
   "info": "Native only on weak devices; upscaling is the single biggest Dreamcast cost."},
  {"key": "reicast_threaded_rendering", "label": "Threaded rendering", "kind": "enum",
   "choices": [["Enabled", "enabled"], ["Disabled", "disabled"]],
   "default": "enabled", "potato": "enabled",
   "info": "Big win on multi-core phones; adds a little input lag."},
  {"key": "reicast_synchronous_rendering", "label": "Synchronous rendering", "kind": "enum",
   "choices": [["Enabled", "enabled"], ["Disabled", "disabled"]],
   "default": "enabled", "potato": "enabled",
   "info": "Fixes frame-pacing instability documented by the project itself."},
  {"key": "reicast_alpha_sorting", "label": "Alpha sorting", "kind": "enum",
   "choices": [["Per-strip (fast)", "per-strip"], ["Per-triangle", "per-triangle"], ["Per-pixel (accurate)", "per-pixel"]],
   "default": "per-strip", "potato": "per-strip"},
  {"key": "reicast_emulate_fog", "label": "Fog effects", "kind": "enum",
   "choices": [["Enabled", "enabled"], ["Disabled", "disabled"]],
   "default": "disabled", "potato": "disabled"},
  {"key": "reicast_anisotropic_filtering", "label": "Anisotropic filtering", "kind": "enum",
   "choices": [["Off", "0"], ["2x", "2"], ["4x", "4"], ["16x", "16"]],
   "default": "0", "potato": "0"},
  {"key": "reicast_dsp", "label": "DSP (audio processor)", "kind": "enum",
   "choices": [["Disabled (fast)", "disabled"], ["Enabled", "enabled"]],
   "default": "disabled", "potato": "disabled",
   "info": "Off removes a large CPU load with no audible loss for most titles."},
  {"key": "reicast_fast_gdrom_load", "label": "Fast GD-ROM load", "kind": "enum",
   "choices": [["Enabled", "enabled"], ["Disabled", "disabled"]],
   "default": "enabled", "potato": "enabled"},
  {"key": "reicast_fast_cdda", "label": "Fast CD audio", "kind": "enum",
   "choices": [["Enabled", "enabled"], ["Disabled", "disabled"]],
   "default": "enabled", "potato": "enabled"}
 ],

 "mednafen_saturn": [
